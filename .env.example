# ── Sao chép thành .env (chạy thử) hoặc chuyển các dòng *_FILE sang Docker secrets (chạy thật) ──
# Tạo khóa ngẫu nhiên:   python -m app.cli gen-secrets
# Băm mật khẩu quản trị: python -m app.cli hash-password

# Zalo Official Account (developers.zalo.me → ứng dụng → Official Account)
ZALO_APP_ID=
ZALO_OA_ID=
ZALO_OA_SECRET=                 # "OA Secret Key" dùng xác minh chữ ký webhook
ZALO_APP_SECRET=                # "Khóa bí mật của ứng dụng" dùng làm mới access token
ZALO_REFRESH_TOKEN=             # chỉ cần cho lần chạy đầu; sau đó bot tự xoay vòng và lưu mã hóa
# ZALO_VERIFIER_FILENAME=zalo_verifierXXXX.html   # nếu Zalo yêu cầu xác minh tên miền
# ZALO_VERIFIER_CONTENT=...

# Shopee — Phương án 1 (ưu tiên): Shopee Affiliate Open API
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Shopee — Phương án 2 (tạm thời, chỉ dùng khi chưa có Open API). Cookie nhập qua trang quản trị.
SHOPEE_WEB_FALLBACK=0
WEB_FALLBACK_PER_MIN=20
# Phương án 2 tự động: bot mở Chrome riêng tới affiliate.shopee.vn, bạn đăng nhập tay một lần,
# bot tự đọc cookie + csrf và cập nhật khi phiên đổi. Chỉ chạy trên máy có Chrome và màn hình (ROLE=all).
SHOPEE_BROWSER=0
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe   # để trống = tự tìm Chrome/Edge
SHOPEE_BROWSER_KEEPALIVE_H=6    # tải lại trang affiliate mỗi N giờ để phiên không hết hạn

# Khóa nội bộ (bắt buộc)
DATA_KEY=                       # 64 ký tự hex, mã hóa token/cookie lưu trên đĩa
USER_HASH_KEY=                  # >= 32 ký tự, băm ID khách
WEBHOOK_PATH_SECRET=            # >= 24 ký tự, nằm trong URL webhook
ADMIN_PASSWORD_HASH=            # chuỗi scrypt$...; trong docker-compose hãy dùng ADMIN_PASSWORD_HASH_FILE vì có ký tự $

# Hạ tầng
HOST=127.0.0.1
PORT=8090
ROLE=all                        # all | gateway | worker (gateway/worker cần REDIS_URL)
REDIS_URL=                      # vd: redis://:matkhau@redis:6379/0
DATA_DIR=data
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128
COOKIE_SECURE=1                 # đặt 0 chỉ khi mở trang quản trị qua http://localhost lúc chạy thử

# Thống kê sub_id
SUB_ID_CHANNEL=zalo
SUB_ID_CAMPAIGN=

# Hạn mức
RATE_PER_USER_PER_MIN=5
RATE_PER_USER_PER_DAY=100
RATE_GLOBAL_PER_MIN=120
MAX_LINKS_PER_MSG=3
QUEUE_MAX=1000
LOG_RETENTION_DAYS=90

# Tra cứu đơn cho khách (khách nhắn /id → nhận mã tra cứu + link trang tra đơn)
LOOKUP_PAGE_URL=                # vd https://tenmien-cua-ban.vn/tra-don/  (phải là https)
CASHBACK_PERCENT=0              # % hoa hồng hiển thị là "tiền hoàn" cho khách; 0 = không hiển thị
LOOKUP_PER_IP_PER_MIN=10
LOOKUP_PER_IP_PER_DAY=200
ORDERS_SYNC_DAYS=30             # Open API: đồng bộ đơn trong N ngày gần nhất, 30 phút/lần
TRUST_CF_HEADER=0               # đặt 1 CHỈ KHI cổng public chỉ nhận kết nối qua Cloudflare Tunnel

# Cảnh báo quản trị qua Telegram (tùy chọn)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
